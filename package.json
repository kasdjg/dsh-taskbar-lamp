{
  "name": "dsh-taskbar-lamp",
  "version": "0.1.7",
  "description": "Taskbar lamp for DeepSeek Harness: shows how many dsh sessions are running right now.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "lamp/*.py",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasdjg/dsh-taskbar-lamp.git"
  },
  "keywords": [
    "dsh-plugin",
    "taskbar",
    "status"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}





